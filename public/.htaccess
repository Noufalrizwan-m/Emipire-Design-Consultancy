# Empire Design Consultancy — Apache / cPanel configuration.
# Replaces what vercel.json and Vercel's platform were doing.
# Vite copies this file into dist/ on build, so it ships with the site.

# ---------------------------------------------------------------- error pages
# Vercel served dist/404.html automatically. Apache needs telling.
ErrorDocument 404 /404.html

<IfModule mod_rewrite.c>
  RewriteEngine On

  # The React form posts to /api/contact. Send it to the PHP handler.
  RewriteRule ^api/contact/?$ /api/contact.php [L]

  # Serve /services (no trailing slash) from /services/index.html directly,
  # instead of letting mod_dir 301-redirect to /services/. Keeps the URL
  # matching the <link rel="canonical"> in each prerendered page.
  DirectorySlash Off
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteCond %{REQUEST_FILENAME}/index.html -f
  RewriteRule ^(.*[^/])$ /$1/index.html [L]
</IfModule>

# ------------------------------------------------------------- security headers
# Ported from vercel.json — these are lost the moment you leave Vercel.
<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=()"

  # Hashed bundles never change content — cache hard.
  <FilesMatch "^index-.*\.(js|css)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>

  # Images: a month, revalidating in the background.
  <FilesMatch "\.(jpg|jpeg|png|webp|avif|svg|ico|woff2)$">
    Header set Cache-Control "public, max-age=2592000, stale-while-revalidate=86400"
  </FilesMatch>

  # HTML must never be cached hard or visitors get stale pages after a deploy.
  <FilesMatch "\.html$">
    Header set Cache-Control "public, max-age=0, must-revalidate"
  </FilesMatch>
</IfModule>

# -------------------------------------------------------------------- mime/webp
<IfModule mod_mime.c>
  AddType image/webp .webp
  AddType image/avif .avif
  AddType font/woff2 .woff2
</IfModule>

# ------------------------------------------------------------------ compression
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css text/plain text/xml \
    application/javascript application/json application/xml image/svg+xml
</IfModule>

# ---------------------------------------------------------------------- privacy
# Don't expose the config file holding your destination address.
<Files "contact-config.php">
  Require all denied
</Files>
